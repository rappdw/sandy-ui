{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "isolatedModules": true,
    "jsx": "preserve"
  },
  "include": ["media/types.d.ts", "media/**/src/**/*.ts"],
  "exclude": ["node_modules", "media/**/dist/**", "media/**/vendor/**"]
}
